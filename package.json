{
  "name": "sprig-mindful-pet",
  "displayName": "Sprig — Mindful Coding Pet",
  "description": "A mindful coding companion: set an intention, focus, take real breaks, breathe, and reflect, with a tiny pixel pet in your sidebar.",
  "version": "1.7.2",
  "publisher": "sameet",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "pet",
    "mindful",
    "mindfulness",
    "focus",
    "pomodoro",
    "break",
    "wellbeing",
    "journal"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "sprig.petView",
          "name": "Sprig 🌱"
        }
      ]
    },
    "commands": [
      {
        "command": "sprig.show",
        "title": "Sprig: Show Pet"
      },
      {
        "command": "sprig.choosePet",
        "title": "Sprig: Choose Pet"
      },
      {
        "command": "sprig.breathe",
        "title": "Sprig: Breathe With Me (1 min)"
      },
      {
        "command": "sprig.startBreak",
        "title": "Sprig: Start a Break Now"
      },
      {
        "command": "sprig.resetFocus",
        "title": "Sprig: Reset Focus Timer"
      },
      {
        "command": "sprig.menu",
        "title": "Sprig: Open Menu"
      },
      {
        "command": "sprig.pause",
        "title": "Sprig: Pause Reminders…"
      },
      {
        "command": "sprig.stats",
        "title": "Sprig: Show This Week's Focus"
      },
      {
        "command": "sprig.startSession",
        "title": "Sprig: Start Mindful Session"
      },
      {
        "command": "sprig.changeIntention",
        "title": "Sprig: Change Intention"
      },
      {
        "command": "sprig.endSession",
        "title": "Sprig: End Session & Reflect"
      },
      {
        "command": "sprig.journal",
        "title": "Sprig: Open Mindful Journal"
      }
    ],
    "configuration": {
      "title": "Sprig",
      "properties": {
        "sprig.pet": {
          "type": "string",
          "default": "sprout",
          "enum": [
            "sprout",
            "clawd",
            "cat",
            "ghost",
            "robot",
            "frog",
            "penguin",
            "mug",
            "alien",
            "computer",
            "bunny",
            "fox",
            "axolotl",
            "panda",
            "duck",
            "octopus",
            "dragon",
            "mushroom",
            "hamster",
            "owl",
            "slime",
            "bee"
          ],
          "enumDescriptions": [
            "Sprig the Sprout",
            "Clawd",
            "Miso the Cat",
            "Boo the Ghost",
            "Bolt the Robot",
            "Pip the Frog",
            "Waddle the Penguin",
            "Bean the Coffee Mug",
            "Zib the Alien",
            "Byte the Computer",
            "Mochi the Bunny",
            "Ember the Fox",
            "Lumi the Axolotl",
            "Bao the Panda",
            "Puddle the Duckling",
            "Inky the Octopus",
            "Cinder the Dragon",
            "Morel the Mushroom",
            "Nugget the Hamster",
            "Hoot the Owl",
            "Gloop the Slime",
            "Buzz the Bee"
          ],
          "description": "Which pet keeps you company."
        },
        "sprig.focusMinutes": {
          "type": "number",
          "default": 25,
          "description": "Minutes of active coding before Sprig suggests a break.",
          "minimum": 1
        },
        "sprig.breakMinutes": {
          "type": "number",
          "default": 5,
          "description": "Length of a break in minutes.",
          "minimum": 1
        },
        "sprig.eyeReminderMinutes": {
          "type": "number",
          "default": 20,
          "description": "20-20-20 eye rest reminder interval (minutes of active coding). 0 to disable.",
          "minimum": 0
        },
        "sprig.hydrationMinutes": {
          "type": "number",
          "default": 45,
          "description": "Water reminder interval (minutes). 0 to disable.",
          "minimum": 0
        },
        "sprig.breakNotifications": {
          "type": "boolean",
          "default": true,
          "description": "Show a VS Code notification when it's time for a break and when a break ends (otherwise Sprig only says it in the sidebar)."
        }
      }
    }
  },
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/sameetvipat/sprig.git"
  },
  "homepage": "https://github.com/sameetvipat/sprig#readme",
  "bugs": {
    "url": "https://github.com/sameetvipat/sprig/issues"
  }
}